# Keep the Docker build context small and the image reproducible.

# Version control and local virtualenvs
.git
.gitignore
.venv
.venv*
venv/
env/

# Local data, run outputs, and model caches (regenerated inside the container)
data/
results/
AutogluonModels/
catboost_info/

# Python / tooling caches
__pycache__/
**/__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Build artifacts
build/
dist/

# Editor / OS clutter and scratch planning dirs
.DS_Store
.vscode/
.idea/
.planning/
.code-review-graph/
